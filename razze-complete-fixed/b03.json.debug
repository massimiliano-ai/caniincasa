      "adattabilita_clima_caldo": 2.5,
      "adattabilita_clima_freddo": 3.0,
      "tolleranza_alla_solitudine": 2.0,
      "compatibilita_con_i_bambini": 5.0,
      "tolleranza_estranei": 4.5,
      "compatibilita_con_altri_animali_domestici": 4.5,
      "facilita_di_addestramento": 1.5,
